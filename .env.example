# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_COMPLETION_TOKENS=1024
# Raise to 1024 if the ambiguity resolver returns truncated tool calls
OPENAI_FALLBACK_MAX_COMPLETION_TOKENS=512

# Fast deterministic order handling; OpenAI is used once only when ambiguous
HYBRID_INTENT_ENABLED=true
HYBRID_LLM_FALLBACK_ENABLED=true
HYBRID_FUZZY_MATCH_ENABLED=true
HYBRID_FUZZY_MIN_SCORE=90
HYBRID_FUZZY_MIN_GAP=10
# After this many size misses, escalate short replies to OpenAI
HYBRID_SIZE_LLM_AFTER_MISSES=1

# Speech-to-text provider (local Whisper by default; ElevenLabs optional)
STT_PROVIDER=whisper
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_STT_MODEL=scribe_v1
# Leave empty/none/auto for auto-detect
ELEVENLABS_STT_LANGUAGE=
ELEVENLABS_STT_TIMEOUT_SECONDS=30

# Local Whisper settings
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=ur
WHISPER_BEAM_SIZE=5
# Roman Urdu food-order hint — reduces Hindi mis-detection
# WHISPER_INITIAL_PROMPT=mujhe pizza chahiye, chicken karahi, biryani, Kasur.
STT_RECORD_SECONDS=5

# Text-to-speech (Piper HTTP)
TTS_PROVIDER=piper_http
PIPER_TTS_URL=http://127.0.0.1:5000
PIPER_TTS_VOICE=ur_PK-aegis_female-medium
PIPER_TTS_TIMEOUT_SECONDS=30
TTS_SAMPLE_RATE=16000
